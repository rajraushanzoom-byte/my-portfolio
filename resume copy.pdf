
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Raj Raushan Kumar | Portfolio</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
            color: #222;
            line-height: 1.6;
        }

        .container {
            max-width: 1000px;
            margin: 40px auto;
            background-color: white;
            padding: 50px;
            border-radius: 15px;
            box-shadow: 0 5px 25px rgba(0, 0, 0, 0.1);
        }


        

        header {
            text-align: center;
            padding-bottom: 35px;
            border-bottom: 2px solid #eee;
        }

        header h1 {
            font-size: 42px;
            margin-bottom: 10px;
        }

        header h2 {
            font-size: 20px;
            font-weight: normal;
            color: #555;
            margin-bottom: 15px;
        }

        .contact {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        .contact a {
            text-decoration: none;
            color: #333;
        }

        .contact a:hover {
            color: #0066ff;
        }


        

        section {
            margin-top: 35px;
        }

        section h2 {
            font-size: 24px;
            margin-bottom: 15px;
            border-left: 5px solid #0066ff;
            padding-left: 10px;
        }


    

        .about {
            color: #555;
            font-size: 16px;
        }


    

        .education-item {
            margin-bottom: 25px;
        }

        .education-item h3 {
            font-size: 20px;
            margin-bottom: 5px;
        }

        .education-item p {
            color: #555;
        }


        

        .skills {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .skill {
            background-color: #eef4ff;
            padding: 8px 15px;
            border-radius: 20px;
            color: #0055cc;
        }




        .interests {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .interest {
            background-color: #f0f0f0;
            padding: 8px 15px;
            border-radius: 20px;
        }


        /* FOOTER */

        footer {
            text-align: center;
            margin-top: 40px;
            padding-top: 25px;
            border-top: 2px solid #eee;
            color: #777;
        }
                .download-btn {
            display: inline-block;
            margin-top: 25px;
            padding: 12px 30px;
            background-color: #0066ff;
            color: white;
            text-decoration: none;
            font-weight: bold;
            border-radius: 8px;
            transition: 0.3s;
        }

        .download-btn:hover {
            background-color: #0049b8;
            transform: translateY(-3px);
        }

    

        @media (max-width: 600px) {

            .container {
                margin: 15px;
                padding: 25px;
            }

            header h1 {
                font-size: 32px;
            }

            header h2 {
                font-size: 17px;
            }

            .contact {
                flex-direction: column;
                align-items: center;
            }

        }

    </style>

</head>


<body>

    <div class="container">


        

        <header>

            <h1>Raj Raushan Kumar</h1>

