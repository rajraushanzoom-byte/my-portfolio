                </span>

                <span class="interest">
                    Problem Solving
                </span>

            </div>

        </section>



        <!-- FOOTER -->

        <footer>

            <p>
                © 2026 Raj Raushan Kumar
            </p>

        </footer>
<a class="download-btn" href="resume copy.pdf" download>
                ⬇ Download Resume
